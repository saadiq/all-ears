# Assembled corpus: build output, reproducible from raw/ + the slot grid by
# `uv run assemble.py build`. The raw/ renders are committed instead — they are
# the part that is NOT reproducible (see docs/engineering-practices.md).
build/

# Probe WAV: generated by `uv run probe.py wav`; its schedule JSON is committed.
probe/*.wav

# Run records. A run worth keeping is committed deliberately, not by default —
# each carries a session tree reference and can be large.
runs/*/
!runs/.gitkeep

# Browser profiles and logs the runner creates.
.work/

# Python bytecode from the harness scripts.
__pycache__/

# Persistent signed-in browser profiles. Never commit these — they hold live
# Google session cookies.
.profiles/
